{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/techmann/artificial-womb-models/schemas/phenotype-intake.schema.json",
  "title": "Source-linked specimen phenotype coverage intake",
  "description": "Shape contract only; runtime additionally enforces exact source/unit/ascertainment/specimen matching, one record per outcome, full declared specimen/endpoint coverage, bounded matrices and separation of populations. Review/roster completeness remain external assertions; no biological effect is estimated.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_dataset",
    "cohorts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "observation_dataset": {
      "$ref": "observation-dataset.schema.json"
    },
    "cohorts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/cohort"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "locator"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "maxLength": 96,
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "maxLength": 1000,
          "minLength": 1
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition_id",
        "label",
        "role",
        "assignment_note",
        "source"
      ],
      "properties": {
        "condition_id": {
          "type": "string",
          "maxLength": 96,
          "minLength": 1
        },
        "label": {
          "type": "string",
          "maxLength": 300,
          "minLength": 1
        },
        "role": {
          "enum": [
            "comparator",
            "exposure",
            "other"
          ]
        },
        "assignment_note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000,
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint_id",
        "assay_name",
        "endpoint",
        "unit",
        "measurement_time",
        "measurement_time_unit",
        "definition",
        "version",
        "calibration_note",
        "uncertainty_note",
        "source"
      ],
      "properties": {
        "endpoint_id": {
          "type": "string",
          "maxLength": 96,
          "minLength": 1
        },
        "assay_name": {
          "type": "string",
          "maxLength": 300,
          "minLength": 1
        },
        "endpoint": {
          "type": "string",
          "maxLength": 500,
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "maxLength": 80,
          "minLength": 1
        },
        "measurement_time": {
          "type": [
            "number",
            "null"
          ]
        },
        "measurement_time_unit": {
          "type": "string",
          "maxLength": 40,
          "minLength": 1
        },
        "definition": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000,
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000,
          "minLength": 1
        },
        "calibration_note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000,
          "minLength": 1
        },
        "uncertainty_note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000,
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "specimen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specimen_id",
        "experiment_id",
        "endometrial_source_id",
        "condition_id",
        "source"
      ],
      "properties": {
        "specimen_id": {
          "type": "string",
          "maxLength": 96,
          "minLength": 1
        },
        "experiment_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 96,
          "minLength": 1
        },
        "endometrial_source_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 96,
          "minLength": 1
        },
        "condition_id": {
          "type": "string",
          "maxLength": 96,
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specimen_id",
        "endpoint_id",
        "record_id",
        "status",
        "reason",
        "source"
      ],
      "properties": {
        "specimen_id": {
          "type": "string",
          "maxLength": 96,
          "minLength": 1
        },
        "endpoint_id": {
          "type": "string",
          "maxLength": 96,
          "minLength": 1
        },
        "record_id": {
          "type": "string",
          "maxLength": 96,
          "minLength": 1
        },
        "status": {
          "enum": [
            "observed",
            "missing",
            "excluded",
            "not_assessed"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 1000
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cohort_id",
        "population",
        "selection_frame",
        "source",
        "conditions",
        "endpoints",
        "specimens",
        "outcomes"
      ],
      "properties": {
        "cohort_id": {
          "type": "string",
          "maxLength": 96,
          "minLength": 1
        },
        "population": {
          "enum": [
            "human_embryo",
            "human_blastoid",
            "other",
            "synthetic_fixture"
          ]
        },
        "selection_frame": {
          "enum": [
            "reported_complete",
            "partial",
            "not_reported"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/endpoint"
          }
        },
        "specimens": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/specimen"
          }
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5000,
          "items": {
            "$ref": "#/$defs/outcome"
          }
        }
      }
    }
  }
}
