{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dylanstechmann/artificial-womb-models/schemas/developmental-observation.schema.json",
  "title": "Measured developmental observation contract",
  "description": "A source-linked record for measured developmental observations. It intentionally separates organism, stage track, model system, assay, independent unit, comparison and raw-data provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "evidence_status", "species", "stage_track", "developmental_interval", "model_system", "assay", "independent_unit", "observation", "source"],
  "properties": {
    "schema_version": { "const": 1 },
    "record_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$" },
    "evidence_status": { "enum": ["measured", "author_reported_summary", "planned", "synthetic_fixture"] },
    "species": { "enum": ["human", "mouse", "ovine", "rat", "chick", "other", "unspecified"] },
    "stage_track": { "enum": ["preimplantation", "implantation_and_placentation", "postimplantation_embryonic", "partial_fetal_support", "transition_to_neonatal", "developmental_outcomes", "organoid_or_tissue_model", "unspecified"] },
    "developmental_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "time_unit", "stage_source_artifact_id"],
      "properties": {
        "label": { "type": "string", "minLength": 2, "maxLength": 120 },
        "start": { "type": ["number", "string", "null"] },
        "end": { "type": ["number", "string", "null"] },
        "time_unit": { "type": "string", "minLength": 1, "maxLength": 40 },
        "stage_source_artifact_id": { "type": "string", "minLength": 2, "maxLength": 96 }
      }
    },
    "model_system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label"],
      "properties": {
        "kind": { "enum": ["intact_organism", "embryo_model", "organoid", "tissue_construct", "cell_culture", "simulation", "other"] },
        "label": { "type": "string", "minLength": 3, "maxLength": 500 },
        "batch_id": { "type": ["string", "null"], "maxLength": 120 },
        "laboratory_id": { "type": ["string", "null"], "maxLength": 120 }
      }
    },
    "assay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "endpoint", "unit", "measurement_role"],
      "properties": {
        "name": { "type": "string", "minLength": 3, "maxLength": 300 },
        "endpoint": { "type": "string", "minLength": 3, "maxLength": 500 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 80 },
        "measurement_role": { "enum": ["morphology", "molecular_identity", "function", "viability", "genome_stability", "adverse_effect", "durability", "environmental_condition", "other"] },
        "functional_evidence_class": {
          "enum": ["direct_function_measurement", "biological_response_proxy", "developmental_outcome", "other"],
          "description": "Optional curator classification of how this measured or reported endpoint relates to a functional claim. A direct_function_measurement observes a process or quantity relevant to the declared function; it does not prove sufficiency or health. A biological_response_proxy is an indirect biomarker or response. A developmental_outcome is a developmental, survival, adverse-effect, transition, or follow-up outcome. Omission is unclassified and is never inferred from endpoint wording."
        },
        "calibration_artifact_id": { "type": ["string", "null"], "maxLength": 96 },
        "functional_context": {
          "type": "object", "additionalProperties": false,
          "description": "Optional source-linked context for an observed compartment and material. Declarations do not verify mechanisms, flux, paired identity or functional sufficiency. Omitted context is never inferred from prose.",
          "required": ["compartment", "material", "process", "quantity_basis", "assessment_context", "source_locator"],
          "properties": {
            "compartment": {"type": "string", "minLength": 1, "maxLength": 300},
            "material": {"type": "string", "minLength": 1, "maxLength": 300},
            "process": {"enum": ["uptake", "intracellular_processing", "passage", "secretion", "tissue_abundance", "developmental_outcome", "other", "unspecified"]},
            "quantity_basis": {"type": "string", "minLength": 1, "maxLength": 300},
            "assessment_context": {"enum": ["in_utero", "ex_utero_whole_embryo", "isolated_tissue", "cell_culture", "simulation", "other", "unspecified"]},
            "source_locator": {"type": "string", "minLength": 1, "maxLength": 1000}
          }
        }
      }
    },
    "independent_unit": {
      "type": "object",
      "description": "The source may report separate independent units without naming them individually. A null id preserves that identity gap; it cannot support a same-unit longitudinal link.",
      "additionalProperties": false,
      "required": ["kind", "id", "parent_id"],
      "properties": {
        "kind": { "enum": ["donor", "pregnant_animal", "fetus", "embryo", "source_kidney", "organoid", "vessel_construct", "culture_batch", "sample_pool", "other", "not_reported"] },
        "id": { "type": ["string", "null"], "maxLength": 120, "description": "Source-reported unit identifier, or null when the source does not identify the unit." },
        "parent_id": { "type": ["string", "null"], "maxLength": 120 },
        "hierarchy_note": { "type": "string", "maxLength": 500 },
        "members": {
          "type": "array", "maxItems": 100, "uniqueItems": true,
          "description": "Optional source-declared members of a named sample_pool. Missing members do not establish disjointness; pooled metadata cannot establish individual developmental continuity.",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["kind", "id"],
            "properties": {
              "kind": { "enum": ["donor", "pregnant_animal", "fetus", "embryo", "source_kidney", "organoid", "vessel_construct", "culture_batch", "other"] },
              "id": { "type": "string", "minLength": 1, "maxLength": 120 },
              "parent_id": { "type": ["string", "null"], "maxLength": 120 }
            }
          }
        }
      },
      "allOf": [{
        "if": {"required": ["members"], "properties": {"members": {"minItems": 1}}},
        "then": {"properties": {"kind": {"const": "sample_pool"}, "id": {"type": "string", "minLength": 1}}}
      }]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "measurement_time", "comparator_id", "replicate_role"],
      "properties": {
        "value": { "type": ["number", "string", "null"] },
        "measurement_time": { "type": ["number", "string", "null"] },
        "measurement_time_unit": { "type": "string", "maxLength": 80 },
        "comparator_id": { "type": ["string", "null"], "maxLength": 120 },
        "replicate_role": { "enum": ["independent", "repeated_measure", "technical", "summary_only", "not_reported"], "description": "Independent denotes a source-reported independent observation; the individual unit id may still be null and unlinked." },
        "measurement_uncertainty": { "type": ["number", "string", "null"] },
        "missingness_reason": { "type": "string", "maxLength": 500 },
        "summary_statistic": {
          "type": "object", "additionalProperties": false,
          "description": "Optional typed source-reported summary. It preserves median [interquartile range], mean ± an explicitly identified standard deviation, or an estimate ± a source-reported quantity whose type may remain not_reported. A null sample size preserves an unresolved denominator; summaries do not imply individual observations or independent replicates.",
          "required": ["kind", "reported_sample_size", "sample_size_scope", "sample_size_source_locator", "source_literal"],
          "properties": {
          "kind": {"enum": ["median_iqr", "mean_sd", "reported_plus_minus"]},
            "lower_quartile": {"type": "number"},
            "upper_quartile": {"type": "number"},
            "mean": {"type": "number"},
            "standard_deviation": {"type": "number", "minimum": 0},
          "estimate": {"type": "number"},
          "plus_minus": {"type": "number", "minimum": 0},
          "plus_minus_type": {"enum": ["standard_deviation", "standard_error", "confidence_interval", "measurement_uncertainty", "not_reported"]},
            "reported_sample_size": {"type": ["integer", "null"], "minimum": 1, "maximum": 1000000000},
            "sample_size_scope": {"type": "string", "minLength": 1, "maxLength": 500},
            "sample_size_source_locator": {"type": "string", "minLength": 1, "maxLength": 1000},
            "source_literal": {"type": "string", "minLength": 1, "maxLength": 200}
          },
          "oneOf": [
            {"properties": {"kind": {"const": "median_iqr"}},
             "required": ["lower_quartile", "upper_quartile"],
             "not": {"anyOf": [{"required": ["mean"]}, {"required": ["standard_deviation"]}, {"required": ["estimate"]}, {"required": ["plus_minus"]}, {"required": ["plus_minus_type"]}]}},
            {"properties": {"kind": {"const": "mean_sd"}},
             "required": ["mean", "standard_deviation"],
           "not": {"anyOf": [{"required": ["lower_quartile"]}, {"required": ["upper_quartile"]}, {"required": ["estimate"]}, {"required": ["plus_minus"]}, {"required": ["plus_minus_type"]}]}},
          {"properties": {"kind": {"const": "reported_plus_minus"}},
           "required": ["estimate", "plus_minus", "plus_minus_type"],
           "not": {"anyOf": [{"required": ["lower_quartile"]}, {"required": ["upper_quartile"]}, {"required": ["mean"]}, {"required": ["standard_deviation"]}]}}
          ]
        },
        "source_qualifications": {
          "type": "array", "maxItems": 20, "uniqueItems": true,
          "description": "Optional source-linked, per-observation qualification declarations. These retain the criterion and source locator; they do not establish scientific validity or analysis eligibility.",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["criterion_code", "status_code", "criterion_label", "source_artifact_id", "source_locator", "reference_value", "reference_unit"],
            "properties": {
              "criterion_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
              "status_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
              "criterion_label": {"type": "string", "minLength": 1, "maxLength": 300},
              "source_artifact_id": {"type": "string", "minLength": 2, "maxLength": 96},
              "source_locator": {"type": "string", "minLength": 1, "maxLength": 1000},
              "reference_value": {"type": ["number", "null"]},
              "reference_unit": {"type": "string", "maxLength": 80}
            }
          }
        },
        "measurement_conditions": {
          "type": "array", "maxItems": 20,
          "description": "Optional source-linked test conditions for this observation, such as operating mode or flow rate. Conditions preserve reported context and do not identify replicates or imply an experimental pairing.",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "value", "unit", "source_locator"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"},
              "value": {"type": ["number", "string"]},
              "unit": {"type": "string", "maxLength": 80},
              "source_locator": {"type": "string", "minLength": 1, "maxLength": 1000}
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "uri", "license", "sha256"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 2, "maxLength": 96 },
        "uri": { "type": "string", "format": "uri" },
        "license": { "type": "string", "minLength": 2, "maxLength": 120 },
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" },
        "retrieved_on": { "type": ["string", "null"], "format": "date" }
      }
    },
    "source_locator": { "type": "string", "minLength": 1, "maxLength": 1000,
                        "description": "Exact source table, worksheet cell, image/table row, or repository record locator for this individual observation." },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 8, "maxLength": 1000 } }
  }
}
