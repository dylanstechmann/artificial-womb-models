{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dylanstechmann/artificial-womb-models/schemas/observation-dataset.schema.json",
  "title": "Source-linked developmental observation dataset",
  "description": "Bounded manual intake contract. Validation checks record structure and declared source metadata. Optional local_path values are hashed only under an explicitly supplied --source-root; source URIs are never fetched, and verification does not establish scientific eligibility or authenticate review metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "title", "source_revision", "artifacts", "observations"],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "source_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision_id", "citation", "source_kind", "source_url", "review_status", "reviewer", "reviewed_on", "review_note"],
      "properties": {
        "revision_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,95}$"},
        "citation": {"type": "string", "minLength": 1, "maxLength": 2000},
        "source_kind": {"enum": ["peer_reviewed_animal", "peer_reviewed_human_invitro", "regulator_discussion", "institution_announcement", "dataset_record", "preprint", "other"]},
        "source_url": {"type": "string", "format": "uri"},
        "review_status": {"enum": ["candidate", "locally_reviewed_included", "locally_reviewed_excluded"]},
        "reviewer": {"type": "string", "maxLength": 200},
        "reviewed_on": {"type": ["string", "null"], "format": "date"},
        "review_note": {"type": "string", "maxLength": 2000}
      }
    },
    "artifacts": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["artifact_id", "uri", "license", "sha256", "retrieved_on"],
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,95}$"},
          "uri": {"type": "string", "format": "uri"},
          "license": {"type": "string", "minLength": 1, "maxLength": 120},
          "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "retrieved_on": {"type": ["string", "null"], "format": "date"},
          "developmental_scope": {
            "type": "object", "additionalProperties": false,
            "description": "Optional curated scope for developmental intervals citing this artifact as their stage source. Exact species, stage and time-unit matches are required. Numeric record bounds must be contained; missing/textual bounds stay unassessed. Source transcription is not verified.",
            "required": ["species", "stage_tracks", "time_unit", "start", "end", "source_locator"],
            "properties": {
              "species": {"enum": ["human", "mouse", "ovine", "rat", "chick", "other", "unspecified"]},
              "stage_tracks": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
                "items": {"enum": ["preimplantation", "implantation_and_placentation", "postimplantation_embryonic", "partial_fetal_support", "transition_to_neonatal", "developmental_outcomes", "organoid_or_tissue_model", "unspecified"]}},
              "time_unit": {"type": "string", "minLength": 1, "maxLength": 40},
              "start": {"type": "number"}, "end": {"type": "number"},
              "source_locator": {"type": "string", "minLength": 1, "maxLength": 1000}
            }
          },
          "local_path": {"type": ["string", "null"], "minLength": 1, "maxLength": 500,
                         "description": "Optional relative path beneath --source-root; runtime rejects absolute paths and dot segments."}
        }
      }
    },
    "observations": {
      "type": "array", "minItems": 1, "maxItems": 5000,
      "items": {"$ref": "developmental-observation.schema.json"}
    },
    "transitions": {
      "type": "array", "maxItems": 500,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["transition_id", "from_record_ids", "to_record_ids", "continuity_status", "note"],
        "properties": {
          "transition_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"},
          "from_record_ids": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string"}},
          "to_record_ids": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string"}},
          "continuity_status": {"enum": ["demonstrated", "contradicted", "not_reported"]},
          "note": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "limitations": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 8, "maxLength": 1000}}
  }
}
